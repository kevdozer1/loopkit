# Copy to .env and fill in. .env is gitignored. Load in PowerShell with: . .\env.ps1
#
# OpenRouter covers Opus, Astra, Sol, Argon, the cheap open model, Luna and d1.
# Best practice: make a dedicated OpenRouter key for loopkit and set a credit limit on the key.
OPENROUTER_API_KEY=
# Glimpse, from platform.elorian.ai
ELORIAN_API_KEY=
# Jev. The same key statebench uses works here.
TYPESAFE_JEV_API_KEY=

# Optional direct provider keys. Leave empty to route through OpenRouter.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LIQUID_API_KEY=

# Paths
LOOPKIT_DATA=D:\loopkit_data
